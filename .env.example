# Streamnco — environment variables template
#
# Do NOT put real secrets here. Real values are managed by:
#   - Lovable Cloud Secrets (backend / edge functions)
#   - Fly.io secrets (clip-generator worker)
#
# The runtime .env at the project root is auto-generated by Lovable Cloud
# and contains ONLY publishable Vite values. It must never be committed.

# Public Vite values (safe to expose to the browser)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MIXPANEL_TOKEN=

# Frontend hard kill switch for Instagram publishing.
# OAuth availability is resolved at runtime via the
# `instagram-oauth-status` edge function (backend INSTAGRAM_OAUTH_ENABLED).
VITE_INSTAGRAM_PUBLISH_ENABLED=false

# ---------------------------------------------------------------
# The following are NEVER set via .env. They live in Lovable Cloud
# Secrets and Fly secrets. Listed here for documentation only.
# ---------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=        # backend only — never expose to frontend
# SUPABASE_DB_URL=                  # backend only
# TWITCH_CLIENT_ID=                 # edge functions
# TWITCH_CLIENT_SECRET=             # edge functions
# TWITCH_EVENTSUB_SECRET=           # edge functions
# TWITCH_TOKEN_ENC_KEY=             # edge functions
# YOUTUBE_CLIENT_ID=                # edge functions
# YOUTUBE_CLIENT_SECRET=            # edge functions
# TIKTOK_CLIENT_KEY=                # edge functions
# TIKTOK_CLIENT_SECRET=             # edge functions
# STRIPE_SECRET_KEY=                # edge functions
# STRIPE_WEBHOOK_SECRET=            # edge functions
# LOVABLE_API_KEY=                  # Lovable AI Gateway (managed)
# TOKEN_ENCRYPTION_KEY=             # edge functions
# OAUTH_STATE_SECRET=               # edge functions
# CRON_SECRET=                      # cron-triggered functions
# WORKER_BASE_URL=                  # Fly clip-generator base URL
# WORKER_SHARED_SECRET=             # Fly clip-generator shared secret

# ---- Meta / Instagram (set in Lovable Cloud Secrets only) ----
# Flow: Instagram API with Instagram Login (direct Instagram OAuth).
# No Facebook Page required on the user side.
# META_APP_ID=                      # Meta App ID (Business app)
# META_APP_SECRET=                  # Meta App Secret
# META_REDIRECT_URI=https://streamnco.fr/auth/instagram/callback
# META_GRAPH_API_VERSION=v21.0      # Graph API version pinned by Streamnco
# META_APP_MODE=                    # optional: development | live
# INSTAGRAM_OAUTH_ENABLED=false     # edge-function side flag
# INSTAGRAM_PUBLISH_ENABLED=false   # edge-function side flag
