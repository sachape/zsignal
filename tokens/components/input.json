{
  "input": {
    "$description": "Champs de saisie (input, textarea, select) — surface enfoncée.",
    "background": { "$type": "color", "default": { "$value": "{color.background.page}" }, "disabled": { "$value": "{color.background.muted}" } },
    "text":       { "$type": "color", "default": { "$value": "{color.text.primary}" }, "placeholder": { "$value": "{color.text.tertiary}" }, "disabled": { "$value": "{color.text.disabled}" } },
    "border":     { "$type": "color", "default": { "$value": "{color.border.default}" }, "focus": { "$value": "{color.border.focus}" }, "danger": { "$value": "{color.border.danger}" } },
    "height":     { "$type": "dimension", "$value": "{control.height.md}" },
    "radius":     { "$type": "dimension", "$value": "{radius.control}" },
    "padding":    { "inline": { "$type": "dimension", "$value": "{space.3}" } },
    "border-width": { "$type": "dimension", "$value": "{border.width.thin}" }
  }
}
