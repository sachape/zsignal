{
  "tabs": {
    "$description": "Onglets (vues liées d'un même objet).",
    "list": { "background": { "$type": "color", "$value": "{color.background.muted}" }, "radius": { "$type": "dimension", "$value": "{radius.control}" } },
    "trigger": {
      "background": { "$type": "color", "active": { "$value": "{color.background.surface}" } },
      "text":       { "$type": "color", "default": { "$value": "{color.text.secondary}" }, "active": { "$value": "{color.text.primary}" } },
      "radius":     { "$type": "dimension", "$value": "{radius.sm}" },
      "padding":    { "inline": { "$type": "dimension", "$value": "{space.3}" }, "block": { "$type": "dimension", "$value": "{space.1}" } }
    }
  }
}
