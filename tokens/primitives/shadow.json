{
  "shadow": {
    "$type": "shadow",
    "$description": "Ombres portées. Discrètes (design sombre : l'ombre se voit peu, on s'appuie surtout sur les bordures).",
    "xs": { "$value": "0 1px 2px 0 hsl(0 0% 0% / 0.20)" },
    "sm": { "$value": "0 2px 4px -1px hsl(0 0% 0% / 0.24)" },
    "md": { "$value": "0 8px 16px -6px hsl(0 0% 0% / 0.30)" },
    "lg": { "$value": "0 16px 32px -12px hsl(0 0% 0% / 0.36)" },
    "xl": { "$value": "0 30px 60px -20px hsl(0 0% 0% / 0.45)" }
  }
}
