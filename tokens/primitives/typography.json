{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Instrument Sans, DM Sans, system-ui, sans-serif", "$description": "Police produit (titres + corps)." },
      "mono": { "$value": "JetBrains Mono, monospace", "$description": "Chiffres tabulaires, code." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },
    "size": {
      "$type": "dimension",
      "$description": "Échelle typographique.",
      "xs":  { "$value": "0.75rem" },
      "sm":  { "$value": "0.8125rem" },
      "base":{ "$value": "0.875rem" },
      "md":  { "$value": "1rem" },
      "lg":  { "$value": "1.125rem" },
      "xl":  { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    }
  },
  "line": {
    "height": {
      "$type": "number",
      "tight":   { "$value": "1.1" },
      "snug":    { "$value": "1.25" },
      "normal":  { "$value": "1.5" },
      "relaxed": { "$value": "1.65" }
    }
  },
  "letter": {
    "spacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.05em" },
      "wider":  { "$value": "0.1em" }
    }
  }
}
