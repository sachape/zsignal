{
  "typography": {
    "$type": "typography",
    "$description": "Styles typographiques composites : famille + taille + graisse + interligne. Line-height dérivé de la taille (ADR 0004).",
    "display": {
      "lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line.height.48}", "letterSpacing": "{letter.spacing.tight}" } }
    },
    "heading": {
      "lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{line.height.40}", "letterSpacing": "{letter.spacing.tight}" } },
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{line.height.32}", "letterSpacing": "{letter.spacing.tight}" } }
    },
    "title": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{line.height.28}", "letterSpacing": "{letter.spacing.normal}" } }
    },
    "body": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.base}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line.height.18}", "letterSpacing": "{letter.spacing.normal}" } }
    },
    "label": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.base}", "fontWeight": "{font.weight.medium}", "lineHeight": "{line.height.18}", "letterSpacing": "{letter.spacing.normal}" } }
    },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line.height.16}", "letterSpacing": "{letter.spacing.wide}" } },
    "code":    { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.base}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line.height.18}", "letterSpacing": "{letter.spacing.normal}" } }
  }
}
